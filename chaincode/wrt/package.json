{
  "name": "wrt-chaincode",
  "version": "0.1.0",
  "private": true,
  "description": "WRT chaincode: warehouse receipts, loans with escrow, disputes",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync-shared": "node scripts/sync-shared.js",
    "prebuild": "npm run sync-shared",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run sync-shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run sync-shared",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "fabric-chaincode-node start"
  },
  "dependencies": {
    "fabric-contract-api": "2.5.8",
    "fabric-shim": "2.5.8",
    "json-stringify-deterministic": "1.0.16",
    "sort-keys-recursive": "2.1.10"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.14",
    "typescript": "~5.9.3"
  }
}
