{
  "name": "@wrt/backend",
  "version": "0.1.0",
  "private": true,
  "description": "WRT REST API: Fabric Gateway client, keeper, SSE events, evidence uploads",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"backend: covered by scripts/scenarios\""
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@grpc/grpc-js": "1.14.6",
    "@hyperledger/fabric-gateway": "1.12.1",
    "@hyperledger/fabric-protos": "0.2.2",
    "@wrt/shared": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
