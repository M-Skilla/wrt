# Copy to .env and adjust. Every value has a default for the local network.
PORT=3001
CORS_ORIGIN=http://localhost:5173
WALLET_DIR=./wallet
UPLOAD_DIR=./uploads
CHANNEL=wrt-channel
CHAINCODE=wrt
# Keeper (spec §5.5): calls EvaluateLoan / EvaluateDisbursement for every open loan.
KEEPER_ENABLED=true
KEEPER_INTERVAL_MS=30000
KEEPER_IDENTITY=keeper-svc
# Identity the backend uses for its own reads (block explorer, event stream).
SERVICE_IDENTITY=reg-01-officer
